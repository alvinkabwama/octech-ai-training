#!/bin/sh
# Blocks pushes to main. Only the trainer updates main.
# Installed by `make setup` (git config core.hooksPath scripts/hooks).
# Trainer override: ALLOW_MAIN_PUSH=1 git push origin main
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo "Blocked: you can't push to main. Push your own branch instead:" >&2
    echo "  git push -u origin trainee/<your-name>-week-<N>" >&2
    exit 1
  fi
done
exit 0
